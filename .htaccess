# BareBonesForms — Security Rules
# These rules work on Apache with mod_rewrite and AllowOverride All.
#
# ─── Nginx equivalent (add to your server block) ──────────────
# Replace BBF_BASE/ with the exact installation path relative to the domain root
# (for /bbf use bbf/; for a root install remove BBF_BASE/). The ^~ and = lines win over any
# regex location wherever you paste them. Nginx uses the FIRST regex location that matches,
# so paste the remaining "location ~" lines ABOVE your other regex locations
# ("location ~ \.php$", a static-file cache such as "location ~* \.(css|js|json)$").
# location = /BBF_BASE/README.md { deny all; }
# location = /BBF_BASE/CHANGELOG.md { deny all; }
# location = /BBF_BASE/.bbf-manifest.json { deny all; }
# location ^~ /BBF_BASE/forms/ { deny all; }
# location ^~ /BBF_BASE/config { deny all; }
# location ^~ /BBF_BASE/bbf_ { deny all; }
# location ^~ /BBF_BASE/submissions/ { deny all; }
# location ^~ /BBF_BASE/logs/ { deny all; }
# location ^~ /BBF_BASE/templates/ { deny all; }
# location ^~ /BBF_BASE/actions/ { deny all; }
# location ^~ /BBF_BASE/backups/ { deny all; }
# location ^~ /BBF_BASE/tests/ { deny all; }
# location ^~ /BBF_BASE/data/ { deny all; }
# location ^~ /BBF_BASE/lang/ { location ~ \.php$ { deny all; } }
# location ~ "(?:\.(?:bak|swp|save|orig|old)$|\.bak[-_]|~$|/#[^/]*#$)" { deny all; }
# location ~ /\. { deny all; }
# location ~ ^/BBF_BASE/.*\.md$ { deny all; }
# autoindex off;
# Keep lang/*.js public: browser translations load these files directly.
# ───────────────────────────────────────────────────────────────

# Disable directory listing globally
Options -Indexes

# Block config files and the internal libraries (bbf_*.php; entry points have other names)
<FilesMatch "^config|^bbf_.*\.php$">
    Require all denied
</FilesMatch>

# Block editor backup and temp files (any file)
# Catches: file.php~, file.bak, file.swp, file.save, file.orig, #file#
<FilesMatch "\.(bak|swp|save|orig|old)$|\.bak[-_]|~$|^#.*#$">
    Require all denied
</FilesMatch>

# Block README/CHANGELOG and other docs: they reveal the exact installed version
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Block all dot-files and dot-directories (.git, .env, .htpasswd, etc.)
RewriteRule (^|/)\. - [F,L]

# Block sensitive directories
RewriteRule ^config/ - [F,L]
RewriteRule ^submissions/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^templates/ - [F,L]
RewriteRule ^actions/ - [F,L]
RewriteRule ^backups/ - [F,L]
RewriteRule ^tests/ - [F,L]
RewriteRule ^data/ - [F,L]

# Block direct access to form JSON definitions and lang PHP files
# (forms are served via submit.php?action=definition, lang via include)
RewriteRule ^forms/.*\.json$ - [F,L]
RewriteRule ^lang/.*\.php$ - [F,L]
